@model List<Customer>

<h1 class="alert alert-info text-center">Customers</h1>

<a asp-action="GetCreateView" class="btn btn-success mb-3">
    Add New Customer
</a>

<form asp-action="GetIndexView" method="get" class="row mb-4">

    <div class="col-5">
        <input type="text"
               name="search"
               value="@ViewBag.CurrentSearch"
               class="form-control"
               placeholder="Search..." />
    </div>

    <div class="col-2">
        <select name="sortType" class="form-select">
            <option value="">Sort By</option>
            <option value="FullName">Full Name</option>
            <option value="Email">Email</option>
            <option value="PhoneNo">Phone</option>
        </select>
    </div>

    <div class="col-2">
        <select name="sortOrder" class="form-select">
            <option value="">Order</option>
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </select>
    </div>

    <div class="col-2">
        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>

</form>

<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>Full Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.FullName</td>
                <td>@customer.PhoneNo</td>
                <td>@customer.Email</td>

                <td>
                    <a asp-action="GetDetailsView"
                       asp-route-id="@customer.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="GetEditView"
                       asp-route-id="@customer.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="GetDeleteView"
                       asp-route-id="@customer.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>