@{
    ViewData["Title"] = "Cinema Booking System";
}

<div class="text-center mt-5">

    <h1 class="display-3 fw-bold">
        Cinema Booking System
    </h1>

    <p class="lead mt-3">
        Book your favorite movies and enjoy your cinema experience.
    </p>

    <a asp-controller="Movies"
       asp-action="GetIndexView"
       class="btn btn-primary btn-lg mt-3">
        Browse Movies
    </a>

</div>