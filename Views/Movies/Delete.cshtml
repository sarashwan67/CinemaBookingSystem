@model Movie

<h1 class="alert alert-danger text-center">
    Delete Movie
</h1>

<div class="card mx-auto shadow"
     style="max-width:600px;">

    <div class="card-body text-center">

        <img src="@Model.PosterPath"
             style="width:180px;height:250px;object-fit:cover;"
             class="mb-3" />

        <h3>
            @Model.Title
        </h3>

        <p>
            Are you sure you want to delete this movie?
        </p>

        <form asp-controller="Movies"
              asp-action="Delete"
              method="post">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>

            <a asp-action="GetIndexView"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>