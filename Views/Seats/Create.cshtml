@model Seat

<h1 class="alert alert-info text-center">
    Create Seat
</h1>

<form asp-action="AddNew"
      method="post"
      class="col-md-6">

    <div class="mb-3">

        <label asp-for="SeatNumber"
               class="form-label"></label>

        <input asp-for="SeatNumber"
               class="form-control" />

        <span asp-validation-for="SeatNumber"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="CinemaHallId"
               class="form-label">
            Cinema Hall
        </label>

        <select asp-for="CinemaHallId"
                asp-items="ViewBag.AllCinemaHalls"
                class="form-select">

            <option value="">
                Select Hall
            </option>

        </select>

        <span asp-validation-for="CinemaHallId"
              class="text-danger"></span>

    </div>

    <button class="btn btn-success">
        Create
    </button>

    <a asp-action="GetIndexView"
       class="btn btn-secondary">
        Back
    </a>

</form>