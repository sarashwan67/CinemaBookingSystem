@model Seat

<h1 class="alert alert-warning text-center">
    Edit Seat
</h1>

<form asp-action="EditCurrent"
      method="post"
      class="col-md-6">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label asp-for="SeatNumber"
               class="form-label"></label>

        <input asp-for="SeatNumber"
               class="form-control" />

        <span asp-validation-for="SeatNumber"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="CinemaHallId"
               class="form-label">
            Cinema Hall
        </label>

        <select asp-for="CinemaHallId"
                asp-items="ViewBag.AllCinemaHalls"
                class="form-select">
        </select>

        <span asp-validation-for="CinemaHallId"
              class="text-danger"></span>

    </div>

    <button class="btn btn-warning">
        Save Changes
    </button>

    <a asp-action="GetIndexView"
       class="btn btn-secondary">
        Back
    </a>

</form>