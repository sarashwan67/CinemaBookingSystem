@model ShowTime

<h1 class="alert alert-warning text-center">
    Edit Show Time
</h1>

<form asp-action="EditCurrent"
      method="post"
      class="col-md-6">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label asp-for="MovieId"
               class="form-label">
            Movie
        </label>

        <select asp-for="MovieId"
                asp-items="ViewBag.AllMovies"
                class="form-select">
        </select>

        <span asp-validation-for="MovieId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="CinemaHallId"
               class="form-label">
            Cinema Hall
        </label>

        <select asp-for="CinemaHallId"
                asp-items="ViewBag.AllCinemaHalls"
                class="form-select">
        </select>

        <span asp-validation-for="CinemaHallId"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Date"
               class="form-label">
            Date
        </label>

        <input asp-for="Date"
               type="date"
               class="form-control" />

        <span asp-validation-for="Date"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="StartTime"
               class="form-label">
            Start Time
        </label>

        <input asp-for="StartTime"
               type="time"
               class="form-control" />

        <span asp-validation-for="StartTime"
              class="text-danger"></span>

    </div>

    <button class="btn btn-warning">
        Save Changes
    </button>

    <a asp-action="GetIndexView"
       class="btn btn-secondary">
        Back
    </a>

</form>